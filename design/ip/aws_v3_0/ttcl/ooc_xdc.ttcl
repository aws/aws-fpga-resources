create_clock           -name clk_main_a0_ooc  -period <=:CLOCK_A0_PERIOD:> [get_ports clk_main_a0]
<: if {$HBM_PRESENT > 0} { :>
create_clock           -name clk_hbm_ref_ooc  -period 10.0 [get_ports clk_hbm_ref]
<: } :>
<: if {$PCIE_EP_PRESENT > 0} { :>
create_clock           -name pcie_ep_ref_clk_ooc  -period 4.0 [get_ports PCIE_EP_REF_CLK_*]
<: } :>
<: if {$PCIE_RP_PRESENT > 0} { :>
create_clock           -name pcie_rp_ref_clk_ooc  -period 4.0 [get_ports PCIE_RP_REF_CLK_*]
<: } :>
